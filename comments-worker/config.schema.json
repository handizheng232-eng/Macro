{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Non-secret production Worker vars (secrets excluded)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ENVIRONMENT",
    "WORKER_ORIGIN",
    "APP_ID",
    "CLIENT_ID",
    "INSTALLATION_ID"
  ],
  "properties": {
    "ENVIRONMENT": {
      "const": "production"
    },
    "WORKER_ORIGIN": {
      "type": "string",
      "pattern": "^https://[a-z0-9.-]+$"
    },
    "APP_ID": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "CLIENT_ID": {
      "type": "string",
      "minLength": 1
    },
    "INSTALLATION_ID": {
      "type": "string",
      "pattern": "^[0-9]+$"
    }
  }
}